# Copy to .env.local and fill in. Never commit a file with real values —
# only this template is tracked.

# Canonical origin, used for absolute URLs in sitemap.xml and robots.txt.
# No production domain is registered yet. On Vercel,
# VERCEL_PROJECT_PRODUCTION_URL is set automatically and used as a fallback;
# set this explicitly once a real domain exists.
# Falls back to http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=
