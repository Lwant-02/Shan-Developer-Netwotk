generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentLang {
  shn
  en

  @@map("content_lang")
}

enum SocialPlatform {
  github
  facebook
  instagram
  line
  linkedin
  telegram
  website

  @@map("social_platform")
}

enum ReportReason {
  spam
  harassment
  hate
  violence
  privateInfo
  impersonation
  malware
  sexual
  offTopic
  other

  @@map("report_reason")
}

enum ReportState {
  open
  resolved
  dismissed

  @@map("report_state")
}

enum NotificationKind {
  comment
  like
  star
  follow
  eventReminder

  @@map("notification_kind")
}

model Profile {
  id              String    @id @default(uuid(7)) @db.Uuid
  authUserId      String    @unique @map("auth_user_id") @db.Uuid
  handle          String    @unique
  displayName     String?   @map("display_name")
  role            String    @default("")
  bio             String    @default("")
  location        String?
  avatarUrl       String?   @map("avatar_url")
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  listed          Boolean   @default(true)
  moderator       Boolean   @default(false)
  joinedAt        DateTime  @default(now()) @map("joined_at")

  links         SocialLink[]
  posts         Post[]
  projects      Project[]
  events        Event[]
  comments      Comment[]
  likes         Like[]
  stars         Star[]
  following     Follow[]       @relation("Follower")
  followers     Follow[]       @relation("Following")
  notifications Notification[] @relation("Recipient")
  actedOn       Notification[] @relation("Actor")
  reportsFiled  Report[]       @relation("Reporter")
  reportsClosed Report[]       @relation("ResolvedBy")

  @@index([listed])
  @@map("profiles")
}

model SocialLink {
  id        String         @id @default(uuid(7)) @db.Uuid
  profileId String         @map("profile_id") @db.Uuid
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform  SocialPlatform
  href      String

  @@unique([profileId, platform])
  @@map("social_links")
}

model Post {
  id        String      @id @default(uuid(7)) @db.Uuid
  slug      String      @unique
  authorId  String      @map("author_id") @db.Uuid
  author    Profile     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  lang      ContentLang
  imagePath String?     @map("image_path")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  likes         Like[]
  comments      Comment[]
  notifications Notification[]
  reports       Report[]

  @@index([createdAt])
  @@index([authorId])
  @@map("posts")
}

model Project {
  id           String      @id @default(uuid(7)) @db.Uuid
  slug         String      @unique
  authorId     String      @map("author_id") @db.Uuid
  author       Profile     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  description  String
  lang         ContentLang
  imagePath    String?     @map("image_path")
  repoUrl      String?     @map("repo_url")
  websiteUrl   String?     @map("website_url")
  appStoreUrl  String?     @map("app_store_url")
  playStoreUrl String?     @map("play_store_url")
  tags         String[]    @default([])
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  stars         Star[]
  comments      Comment[]
  notifications Notification[]
  reports       Report[]

  @@index([createdAt])
  @@index([authorId])
  @@map("projects")
}

model Event {
  id          String      @id @default(uuid(7)) @db.Uuid
  slug        String      @unique
  hostId      String      @map("host_id") @db.Uuid
  host        Profile     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  title       String
  description String
  lang        ContentLang
  imagePath   String?     @map("image_path")
  startsAt    DateTime    @map("starts_at")
  timezone    String      @default("UTC")
  online      Boolean     @default(true)
  location    String      @default("")
  joinUrl     String?     @map("join_url")
  registerUrl String?     @map("register_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  stars         Star[]
  comments      Comment[]
  notifications Notification[]
  reports       Report[]

  @@index([startsAt])
  @@index([hostId])
  @@map("events")
}

model Comment {
  id        String      @id @default(uuid(7)) @db.Uuid
  authorId  String      @map("author_id") @db.Uuid
  author    Profile     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  lang      ContentLang
  createdAt DateTime    @default(now()) @map("created_at")

  parentId String?   @map("parent_id") @db.Uuid
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  postId    String?  @map("post_id") @db.Uuid
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId   String?  @map("event_id") @db.Uuid
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([postId])
  @@index([projectId])
  @@index([eventId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  postId    String   @map("post_id") @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([profileId, postId])
  @@index([postId])
  @@map("likes")
}

model Star {
  id        String   @id @default(uuid(7)) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId   String?  @map("event_id") @db.Uuid
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([profileId, projectId])
  @@unique([profileId, eventId])
  @@index([projectId])
  @@index([eventId])
  @@map("stars")
}

model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  follower    Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @map("following_id") @db.Uuid
  following   Profile  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   Profile          @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  actorId     String?          @map("actor_id") @db.Uuid
  actor       Profile?         @relation("Actor", fields: [actorId], references: [id], onDelete: Cascade)

  postId    String?  @map("post_id") @db.Uuid
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId   String?  @map("event_id") @db.Uuid
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  commentId String?  @map("comment_id") @db.Uuid
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([actorId])
  @@index([postId])
  @@index([projectId])
  @@index([eventId])
  @@index([commentId])
  @@map("notifications")
}

model Report {
  id         String       @id @default(uuid(7)) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reporter   Profile      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  state      ReportState  @default(open)

  postId    String?  @map("post_id") @db.Uuid
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId   String?  @map("event_id") @db.Uuid
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedBy   Profile?  @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([state, createdAt])
  @@index([reporterId])
  @@index([resolvedById])
  @@index([postId])
  @@index([projectId])
  @@index([eventId])
  @@map("reports")
}
